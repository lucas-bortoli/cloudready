{
  "name": "cloudready",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:kernel": "cargo run",
    "build:frontend": "tsc && vite build",
    "build": "npm run build:frontend && cargo build --release",
    "test:frontend": "vitest run --passWithNoTests",
    "test:kernel": "cargo test",
    "test:kernel:release": "npm run build:frontend && cargo test --release",
    "test": "npm run test:frontend && npm run test:kernel && npm run test:kernel:release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@carbon/icons": "^11.88.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,css,md,yml,yaml}": "prettier --write"
  }
}
