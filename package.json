{
  "name": "cloudready",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:kernel": "cargo run",
    "build:frontend": "vp exec tsc && vp build",
    "build": "vp run build:frontend && cargo build --release",
    "test:frontend": "vp test run --passWithNoTests",
    "test:kernel": "cargo test",
    "test:kernel:release": "vp run build:frontend && cargo test --release",
    "test": "vp run test:frontend && vp run test:kernel && vp run test:kernel:release",
    "prepare": "vp config"
  },
  "dependencies": {
    "lucide-solid": "^1.47.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "0.3.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  }
}
